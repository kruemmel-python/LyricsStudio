     if (detect_change)
         av_log(ctx, AV_LOG_DEBUG, "Change happened at time ms:%f\n", time_ms);
 
+    if (ass->reuse_unchanged && !detect_change &&
+        same_pixel_view(picref, ass->last_source)) {
+        ass->reused_frames++;
+        av_frame_free(&picref);
+        return 0;
+    }
+
+    if (ass->reuse_unchanged) {
+        AVFrame *source = av_frame_clone(picref);
+        if (!source) {
+            av_frame_free(&picref);
+            return AVERROR(ENOMEM);
+        }
+        av_frame_free(&ass->last_source);
+        ass->last_source = source;
+    }
+
+    int ret = av_frame_make_writable(picref);
+    if (ret < 0) {
+        av_frame_free(&picref);
+        return ret;
+    }
+
     overlay_ass_image(ass, picref, image);
+    ass->rendered_frames++;
 
     return ff_filter_frame(outlink, picref);
 }
