+/*
+ * Return true only when both frames are views onto the exact same immutable
+ * pixel storage.  This is deliberately stricter than a visual comparison:
+ * Klanggeist places a loop directly after its one-time cover scale, so equal
+ * integer crop positions have identical data pointers and line sizes.
+ */
+static int same_pixel_view(const AVFrame *a, const AVFrame *b)
+{
+    if (!a || !b || a->format != b->format ||
+        a->width != b->width || a->height != b->height)
+        return 0;
+
+    for (int i = 0; i < AV_NUM_DATA_POINTERS; i++) {
+        if (a->data[i] != b->data[i] || a->linesize[i] != b->linesize[i])
+            return 0;
+    }
+    return 1;
+}
